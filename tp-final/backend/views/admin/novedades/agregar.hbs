<section class="tarjeta">
  <h1>Agregar novedad</h1>

  {{#if error}}
    <p class="alerta alerta-error">{{error}}</p>
  {{/if}}

  <form action="/admin/novedades/agregar" method="post" class="formulario">
    <label for="titulo">Título</label>
    <input type="text" id="titulo" name="titulo" maxlength="250" value="{{novedad.titulo}}" required>

    <label for="subtitulo">Subtítulo</label>
    <input type="text" id="subtitulo" name="subtitulo" maxlength="250" value="{{novedad.subtitulo}}" required>

    <label for="cuerpo">Cuerpo</label>
    <textarea id="cuerpo" name="cuerpo" rows="7" required>{{novedad.cuerpo}}</textarea>

    <div class="botones">
      <button type="submit" class="boton">Guardar</button>
      <a href="/admin/novedades" class="boton boton-secundario">Cancelar</a>
    </div>
  </form>
</section>
